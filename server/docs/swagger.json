    "definitions": {
        "dtos.AICorrectionDTO": {
            "type": "object",
            "required": [
                "exercise"
            ],
            "properties": {
                "exercise": {
                    "type": "string"
                }
            }
        },
        "dtos.AIDocumentSaveDTO": {
            "type": "object",
            "required": [
                "content",
                "doc_type",
                "event_id"
            ],
            "properties": {
                "content": {
                    "type": "string"
                },
                "doc_type": {
                    "type": "string",
                    "enum": [
                        "EXERCISE",
                        "CORRECTION"
                    ]
                },
                "event_id": {
                    "type": "string"
                }
            }
        },
        "dtos.ForgotPasswordDTO": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string"
                }
            }
        },
        "dtos.LoginDTO": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "dtos.RegisterDTO": {
            "type": "object",
            "required": [
                "birthDate",
                "email",
                "firstname",
                "lastname",
                "password",
                "username"
            ],
            "properties": {
                "address": {
                    "type": "string"
                },
                "bio": {
                    "type": "string"
                },
                "birthDate": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "firstname": {
                    "type": "string"
                },
                "lastname": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "picture": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "dtos.ResetPasswordDTO": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        }
    }
